# Public URL and access. Generate long random values for production.
APP_ORIGIN=http://localhost:5173
APP_URL=http://localhost
POSTA_PUBLIC_URL=http://localhost:9000
API_PORT=3001
API_TOKEN=change-me-with-a-long-random-token

# Core services
POSTGRES_DB=leadforge
POSTGRES_USER=leadforge
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://leadforge:change-me@postgres:5432/leadforge
REDIS_URL=redis://redis:6379

# safe = no real scraping/search/email. live = configured provider calls.
PROVIDER_MODE=safe

# research = stop after finding the decision-maker
# enrichment = find/verify email, then stop (recommended until mail is configured)
# draft = also prepare a campaign draft; sending still requires ENABLE_EMAIL_SENDING=true
PIPELINE_STOP_AFTER=enrichment

# Pipeline cut-offs. The worker evaluates each business independently while
# queues overlap, so crawling continues while earlier records reach AI/search.
MIN_FILTER_SCORE=25
MIN_QUALIFICATION_SCORE=60
MAX_DISCOVERY_RESULTS=5000
MAX_PAGES_PER_SITE=8
CHROMIUM_PATH=/usr/bin/chromium

# Resource-aware worker concurrency for an 8 GB VPS.
DISCOVERY_CONCURRENCY=1
CRAWL_CONCURRENCY=3
AI_CONCURRENCY=1
SEARCH_CONCURRENCY=2
ENRICHMENT_CONCURRENCY=2
CAMPAIGN_CONCURRENCY=1

# Optional self-hosted providers (internal Docker DNS names shown).
GMAPS_API_URL=http://gmaps:8080
SEARXNG_URL=http://searxng:8080
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:4b
# One full vCPU maximum. The model unloads immediately after each AI request.
OLLAMA_CPU_LIMIT=1.0
POSTA_URL=http://posta:9000
POSTA_API_KEY=
POSTA_WEBHOOK_SECRET=change-me-webhook-secret
POSTA_FROM=hello@example.com
POSTA_DOMAIN=posta.example.com
POSTA_DB_PASSWORD=change-me-posta-db
POSTA_JWT_SECRET=change-me-with-at-least-32-random-characters
POSTA_ADMIN_EMAIL=admin@example.com
POSTA_ADMIN_PASSWORD=change-me-with-a-strong-password
POSTA_ENCRYPTION_KEY=change-me-with-32-bytes-of-random-data

# Sending is a second lock in addition to PROVIDER_MODE=live.
ENABLE_EMAIL_SENDING=false
DAILY_SEND_LIMIT=100

# Compose-only secrets/settings
SEARXNG_SECRET_KEY=change-me-with-openssl-rand-hex-32
DOMAIN=localhost
